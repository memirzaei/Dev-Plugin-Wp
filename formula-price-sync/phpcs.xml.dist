<?xml version="1.0"?>
<ruleset name="FormulaPriceSync">
    <description>Formula Price Sync production coding standard.</description>
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="parallel" value="4"/>
    <arg value="sp"/>
    <arg name="warning-severity" value="0"/>

    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra"/>

    <!-- Release gate: keep security and SQL correctness blocking; suppress legacy style-only noise
         from the existing production tree so this gate reflects actionable defects. -->
    <rule ref="Generic.WhiteSpace.DisallowSpaceIndent"/>
    <rule ref="Generic.Formatting.MultipleStatementAlignment"/>
    <rule ref="Generic.Formatting.DisallowMultipleStatements"/>
    <rule ref="Universal.WhiteSpace.CommaSpacing"/>
    <rule ref="Universal.Operators.DisallowShortTernary"/>
    <rule ref="Universal.Operators.DisallowStandalonePostIncrementDecrement"/>
    <rule ref="WordPress.Arrays.MultipleStatementAlignment.DoubleArrowNotAligned"/>
    <rule ref="WordPress.Arrays.ArrayDeclarationSpacing"/>
    <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    <rule ref="WordPress.Files.FileName.InvalidClassFileName"/>
    <rule ref="PEAR.Functions.FunctionCallSignature"/>
    <rule ref="Squiz.ControlStructures.ControlSignature"/>
    <rule ref="Squiz.Operators.IncrementDecrementUsage"/>
    <rule ref="Squiz.Strings.DoubleQuoteUsage"/>
    <rule ref="PSR2.Files.EndFileNewline"/>

    <rule ref="WordPress.WP.Capabilities.Unknown">
        <properties>
            <property name="custom_capabilities" type="array" value="manage_woocommerce,edit_product"/>
        </properties>
    </rule>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/languages/*</exclude-pattern>
    <exclude-pattern>/assets/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/\.git/*</exclude-pattern>

    <file>formula-price-sync.php</file>
    <file>uninstall.php</file>
    <file>includes/</file>
</ruleset>
