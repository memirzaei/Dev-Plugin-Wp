<?xml version="1.0"?>
<ruleset name="FormulaPriceSync">
    <description>Formula Price Sync production coding standard.</description>
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="parallel" value="4"/>
    <arg value="sp"/>
    <arg name="warning-severity" value="0"/>

    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra"/>

    <!-- Release gate: keep security and SQL correctness blocking; suppress legacy style-only noise
         from the existing production tree so this gate reflects actionable defects. -->
    <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
    <exclude name="Generic.Formatting.MultipleStatementAlignment"/>
    <exclude name="Generic.Formatting.DisallowMultipleStatements"/>
    <exclude name="Universal.WhiteSpace.CommaSpacing"/>
    <exclude name="Universal.Operators.DisallowShortTernary"/>
    <exclude name="Universal.Operators.DisallowStandalonePostIncrementDecrement"/>
    <exclude name="WordPress.Arrays.MultipleStatementAlignment.DoubleArrowNotAligned"/>
    <exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    <exclude name="PEAR.Functions.FunctionCallSignature"/>
    <exclude name="Squiz.ControlStructures.ControlSignature"/>
    <exclude name="Squiz.Operators.IncrementDecrementUsage"/>
    <exclude name="Squiz.Strings.DoubleQuoteUsage"/>
    <exclude name="PSR2.Files.EndFileNewline"/>
    <exclude name="WordPress.WhiteSpace.OperatorSpacing"/>
    <exclude name="Squiz.PHP.DisallowMultipleAssignments"/>
    <exclude name="WordPress.WhiteSpace.ControlStructureSpacing"/>
    <exclude name="WordPress.Arrays.CommaAfterLast"/>
    <exclude name="Generic.ControlStructures.InlineControlStructure"/>
    <exclude name="Generic.NamingConventions.UpperCaseConstantName"/>
    <exclude name="PEAR.Functions.FunctionDeclaration"/>
    <exclude name="PSR2.Classes.PropertyDeclaration"/>
    <exclude name="PSR2.Methods.MethodDeclaration"/>
    <exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
    <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing"/>
    <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing"/>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/languages/*</exclude-pattern>
    <exclude-pattern>/assets/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/\.git/*</exclude-pattern>

    <file>formula-price-sync.php</file>
    <file>uninstall.php</file>
    <file>includes/</file>
</ruleset>
